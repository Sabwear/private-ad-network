# Copy this file to .env.local and get both values from the Supabase project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Required for administrator-created invitations and Auth access controls.
# Use the current sb_secret_ key from Project Settings > API Keys.
SUPABASE_SECRET_KEY=sb_secret_your_server_key
STREAM_VIEWER_HASH_SECRET=replace_with_at_least_32_random_bytes

# Server-only migration connection. Prefer the shared pooler's session-mode port 5432 for CLI migrations.
# Keep the real password only in .env.database.local; never commit it or expose it through NEXT_PUBLIC_*.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-url-encoded-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Never put a secret or legacy service-role key in a NEXT_PUBLIC_ variable.
