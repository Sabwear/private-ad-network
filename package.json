{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:start": "supabase --workdir ../.. start",
    "db:stop": "supabase --workdir ../.. stop",
    "db:reset": "supabase --workdir ../.. db reset",
